.DS_Store

# Rust build output. A-SABR itself is a pinned git dependency in
# rust/asabr-cli/Cargo.toml, so Cargo fetches it into ~/.cargo and nothing
# upstream is copied into this repository.
rust/asabr-cli/target/

# scenarios/scale_*/ used to be ignored because the working tree is ~7 MB.
# They are committed now: the JSON compresses to ~190 kB in the pack, which is
# a small price for making experiments/run_runtime.py reproducible from a bare
# clone. Regenerate them with scripts/generate_skeletons.sh if the scenario
# changes.
logs/
